.PHONY: test-integration test-integration-sqlite test-integration-postgresql test-integration-mysql

test-integration:
	DB_TYPE=sqlite go test -v -count=1 -timeout 300s ./tests/integration/...

test-integration-sqlite:
	DB_TYPE=sqlite go test -v -count=1 -timeout 300s ./tests/integration/...

test-integration-postgresql:
	DB_TYPE=postgresql go test -v -count=1 -timeout 300s ./tests/integration/...

test-integration-mysql:
	DB_TYPE=mysql go test -v -count=1 -timeout 300s ./tests/integration/...
